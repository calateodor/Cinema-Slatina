# Baza de date PostgreSQL.
# Local: rulează `npx create-db` pentru o bază temporară gratuită,
# sau folosește Postgres-ul tău.
# Pe Vercel: se completează automat dacă adaugi Prisma Postgres sau Neon
# din Marketplace.
DATABASE_URL=""

# Secretul cu care se semnează sesiunile. Minim 32 de caractere.
# Generează unul cu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# TMDB — preluarea automată a descrierii, posterului și trailerului
# după link de IMDb. Cheie gratuită: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Furnizor SMS: "console" scrie codul în terminal (util fără contract SMS),
# "smso" trimite SMS-uri reale prin smso.ro
SMS_PROVIDER="console"
SMSO_API_KEY=""
SMSO_SENDER="CinemaSLT"
